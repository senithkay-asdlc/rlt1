{
  "version": 3,
  "permissions": [
    {
      "resource": "todos",
      "component": "todo-api",
      "description": "A user's own todo items",
      "actions": [
        { "handle": "read", "description": "The caller's own todos" },
        { "handle": "create", "description": "Create a new todo" },
        { "handle": "complete", "description": "Mark one of the caller's todos as done" }
      ]
    }
  ],
  "groups": [
    { "name": "Users", "description": "Everyone who signs in to use the todo app" }
  ],
  "roles": [
    {
      "name": "User",
      "description": "Creates todos and marks their own todos done.",
      "stories": [1, 2, 3, 4],
      "grants": ["todos:read", "todos:create", "todos:complete"],
      "assignTo": ["Users"]
    }
  ],
  "testUsers": [
    { "username": "test-user", "roles": ["User"] },
    { "username": "test-user-2", "roles": ["User"] }
  ]
}
